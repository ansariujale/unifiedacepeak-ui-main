# Copy to /opt/queue-agent-service/.env and fill in MONGODB_URI.
#
# The queue records the product writes live in MongoDB, and the switch already
# has the connection line for it. Copy it from the dialplan service rather than
# typing it out, so the two can never point at different databases:
#
#   grep -E '^MONGODB_(URI|DATABASE)=' /opt/fs-xml-api-1.2.5/.env
#
MONGODB_URI=mongodb+srv://user:password@cluster.mongo.ondigitalocean.com/?tls=true&authSource=admin&replicaSet=…
MONGODB_DATABASE=mycountrymobile_db

# A note on the address form. "mongodb+srv://" needs python3-dnspython as well
# as python3-pymongo, because the driver has to look the servers up first. If
# you would rather install one package than two, write the plain form instead -
# same credentials, the server named directly, and it needs no lookup:
#
#   mongodb://user:password@host:27017/?tls=true&authSource=admin&replicaSet=…
#
# The trade is that the plain form has to be corrected by hand if the database
# is ever moved. The lookup form follows it on its own.

# The switch asks for this on localhost:9006 and nowhere else. Do not put a
# public address here: there is no login on these endpoints by default.
HTTP_LISTEN_ADDR=127.0.0.1:9006

# "localhost" can mean either loopback address, and a caller that picks the one
# we are not on simply gets refused. Answering on both removes the coin toss.
# Set empty to switch the IPv6 one off.
HTTP_LISTEN_HOST6=::1

BASE_DOMAIN=mycountrymobile.com
LOG_LEVEL=info

# The hard limit on every database call, in milliseconds. The switch puts no
# time limit on the request it makes here, so this is the thing that stops a
# slow database from holding a real caller on a silent line.
DB_TIMEOUT_MS=2000
DB_POOL_MAX=8

# How long one answer may be reused. Every waiting caller asks the same question
# every couple of seconds, so this is what keeps the database quiet.
AGENT_CACHE_SECONDS=2

# How long each ring round lasts when a queue is set up to widen - first group
# first, wider group added if nobody picks up. The platform does not record this
# per queue, so it is one number for all of them.
ACD_STEP_SECONDS=15

# How long a run of missed calls keeps somebody out of the queue. Without a
# limit, one bad afternoon would remove them for good.
NO_ANSWER_WINDOW_SECONDS=3600

# How long we remember which phones we already tried for one caller.
CALL_MEMORY_SECONDS=3600
CALL_MEMORY_MAX=5000

# Optional. Left empty, anything that can reach the service is trusted - and only
# this machine can. If you fill it in, it must list BOTH tokens: the one the
# switch sends and the one the event manager sends (FS_CALLCENTER_TOKEN), or one
# of the two stops working.
AUTH_TOKENS=
